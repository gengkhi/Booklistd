# Copy to .env — Expo exposes EXPO_PUBLIC_* to the app bundle (anon key only, never service_role)

# Base project URL only. Dashboard > Settings > API shows the REST endpoint
# (…/rest/v1/) — do NOT paste that; supabase-js appends /rest/v1/ itself.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
