{
  "expo": {
    "name": "Booklistd",
    "slug": "booklistd",
    "version": "0.1.0",
    "scheme": "booklistd",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.sean.booklistd",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Booklistd uses the camera to scan book barcodes so you can catalog books and check ownership in stores."
      }
    },
    "android": {
      "package": "com.sean.booklistd",
      "permissions": ["CAMERA"],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Booklistd uses the camera to scan book barcodes so you can catalog books and check ownership in stores."
        }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
